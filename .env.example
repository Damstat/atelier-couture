# Copier ce fichier en .env puis remplir les valeurs (ne jamais commiter .env)
POSTGRES_USER=atelier
POSTGRES_PASSWORD=a-remplacer
POSTGRES_DB=atelier_db
# "db" dans Docker Compose, "localhost" pour lancer l'API ou les tests sur la machine
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Générer avec : python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=a-remplacer-par-une-longue-chaine-aleatoire
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Premier administrateur créé par : python -m app.seed (mot de passe : 8 caractères minimum)
ADMIN_EMAIL=admin@atelier.sn
ADMIN_PASSWORD=a-remplacer
ADMIN_NOM=Patron
